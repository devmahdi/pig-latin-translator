# ===========================================
# Emoji Translator Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# Site Configuration
# ------------------
NEXT_PUBLIC_SITE_URL=https://emoji.mrtranslator.app
NEXT_PUBLIC_SITE_NAME=Emoji Translator

# CMS API (Blog)
# --------------
NEXT_PUBLIC_CMS_API_URL=https://cms-micros.kimura.team/api
CMS_API_KEY=
SITE_ID=

# Analytics (Optional)
# --------------------
NEXT_PUBLIC_GA_ID=

# Localization
# ------------
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Docker Configuration
# --------------------
PORT=3000
HOSTNAME=0.0.0.0
